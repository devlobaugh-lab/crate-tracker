rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())).data.role == 'admin';
    }

    // Helper function to check if user is authorized (exists in authorizedUsers)
    function isAuthorized() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower()));
    }

    // Helper function to validate Gmail address format
    function isValidGmailAddress(email) {
      return email.matches('^[a-zA-Z0-9._%+-]+@gmail\\.com$');
    }

    // Enhanced authorized users collection - for user checking and admin management
    match /authorizedUsers/{gmailAddress} {
      // Any authenticated user can check if they exist (for authorization logic)
      // Admins can read any user document for management purposes
      allow read: if isAuthenticated() && (request.auth.token.email.lower() == gmailAddress || isAdmin());
      // Only admins can read all users (for admin panel listing)
      allow list: if isAdmin();
      // Only admins can create/modify/delete other users
      // Admins can write to any document, but users can only read their own
      allow create: if isAdmin() &&
                       isValidGmailAddress(gmailAddress) &&
                       request.resource.data.keys().hasAll(['email', 'role', 'status', 'createdAt', 'updatedAt']) &&
                       request.resource.data.role in ['admin', 'normal'] &&
                       request.resource.data.status in ['active', 'inactive'];
      allow update, delete: if isAdmin();
    }

    // Enhanced users collection - only authorized users can access
    match /users/{userId} {
      allow read, write: if isAuthorized() && isOwner(userId);
      allow create: if isAuthorized() && isAuthenticated() && request.auth.uid == userId;
    }

    // For development/testing purposes, restrict to authenticated users only
    match /test/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Default deny rule for any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
